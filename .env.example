DJANGO_SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=your.domain,127.0.0.1,localhost

# Postgres
POSTGRES_DB=automarks
POSTGRES_USER=automarks
POSTGRES_PASSWORD=change_me_db_password

# TLS / Nginx / Certbot
DOMAIN=your.domain
CERTBOT_EMAIL=you@example.com

# Runtime
DEBUG=0

# Сокращатель ссылок: базовый домен коротких ссылок (без завершающего /)
SHORTLINK_BASE_DOMAIN=https://automarks.tw1.ru

# Авто-sync справочника UTM: CSV-экспорт вкладок Google Sheet (Файл → Опубликовать → CSV)
UTM_DICTIONARY_MEDIUM_CSV_URL=
UTM_DICTIONARY_SOURCE_CSV_URL=
UTM_DICTIONARY_CAMPAIGN_CSV_URL=

# Global DB sync (remote)
GLOBAL_PGHOST=
GLOBAL_PGPORT=
GLOBAL_PGDB=
GLOBAL_PGUSER=
GLOBAL_PGPASSWORD=
GLOBAL_PGSCHEMA=activation_data

# Task board Telegram notifications
TASKS_PLATFORM_NAME=
TELEGRAM_NOTIFY_BOT_TOKEN=
TELEGRAM_NOTIFY_NEW_TASKS_CHAT_ID=
TELEGRAM_NOTIFY_STATUS_CHAT_ID=
TASKS_TIME_ZONE=UTC
WEEKLY_TASKS_REPORT_CHAT_ID=
WEEKLY_TASKS_REPORT_TZ=Europe/Moscow
TELEGRAM_WEBHOOK_SECRET=

# --- Раздел TikTok-воронок ---
# Токен-гейт на Дев-панель + Кабинеты (один общий)
FUNNELS_DEV_TOKEN=
# Константы генерации JS-скрипта лендинга
YM_COUNTER_ID=
FUNNELS_WEBHOOK_URL=
FUNNELS_WEBHOOK_TOKEN=
# База рекламной UTM-ссылки (домен лендингов, без завершающего /)
LANDING_BASE_URL=https://go-egeland.ru
# Dual-write в склад через вебхук n8n `funnel-sync`
N8N_SYNC_URL=
N8N_SYNC_TOKEN=
# Чат уведомлений о новых заявках (опц.)
FUNNELS_NOTIFY_CHAT_ID=
